{
  "expo": {
    "name": "Trotamundos",
    "slug": "trotamundos-frontend",
    "scheme": "trotamundos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f19",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Trotamundos necesita acceder a tus fotos para subirlas a tus publicaciones."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0f19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "Trotamundos necesita acceder a tus fotos para subirlas a tus publicaciones." }],
      ["expo-location", { "locationWhenInUsePermission": "Trotamundos usa tu ubicación para detectar el país y la ciudad donde estás." }]
    ]
  }
}
